    "framer-motion": "^14.10.0",
    "idb": "^8.0.3",
    "katex": "^0.19.0",
    "lucide-react": "^1.52.0",
    "mermaid": "^12.2.0",
    "prismjs": "^1.30.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
