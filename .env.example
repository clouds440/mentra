# Compose defaults; no credentials are currently required.
APP_ENV=development
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SQLITE_DB_PATH=/data/mentra.db
# Reserved configuration only; no LLM or vector service is currently started.
LLM_PROVIDER=none
VECTOR_DB_PROVIDER=none
# Must be reachable from the browser; don't use a Docker-only service hostname.
VITE_API_URL=http://localhost:8000
