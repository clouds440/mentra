# Copy to .env and configure the chat provider and Qdrant Cloud before starting.
APP_ENV=development
# Production requires explicit HTTPS FRONTEND_ORIGIN and CORS_ORIGINS (no wildcard).
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Host listener addresses. For a reverse proxy on this host, use 127.0.0.1.
BACKEND_BIND_ADDRESS=0.0.0.0
FRONTEND_BIND_ADDRESS=0.0.0.0
FRONTEND_ORIGIN=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Trust only the actual reverse proxy address for forwarded client IPs; never use *.
FORWARDED_ALLOW_IPS=127.0.0.1
# Required: your complete Supabase PostgreSQL connection URL, with required SSL options.
DATABASE_URL=
# Optional local database: start with `docker compose --profile local-db up -d postgres`.
# Then set DATABASE_URL=postgresql://mentra:mentra_local@postgres:5432/mentra for Docker,
# or use 127.0.0.1 instead of postgres for native Python.
POSTGRES_USER=mentra
POSTGRES_PASSWORD=mentra_local
POSTGRES_DB=mentra
POSTGRES_PORT=5432
# Explicit, separate database for tests. Never falls back to DATABASE_URL.
TEST_DATABASE_URL=

AUTH_SESSION_SECONDS=3600
# HTTP-only browser cookies. Use true with HTTPS in deployments.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax

# Any OpenAI-compatible chat endpoint. DeepSeek, Groq, and OpenAI use the same adapter.
AI_PROVIDER=openai_compatible
AI_MODEL=
# Optional vision-capable model for assessment answer-sheet transcription.
# Empty inherits AI_MODEL. Images always require student review before grading.
AI_VISION_MODEL=
ASSESSMENT_VISION_ENABLED=true
ASSESSMENT_GENERATION_OUTPUT_TOKENS=8192
ASSESSMENT_GRADING_OUTPUT_TOKENS=8192
AI_BASE_URL=
AI_API_KEY=
AI_TEMPERATURE=0.2
AI_TIMEOUT=30
AI_MAX_RETRIES=2
# Parameter presence/types/counts only; no request/response content is stored.
LOG_PARAMETER_DETAILS=true
# Chat input limits are separate from the 16k assessment workflow context.
CHAT_INPUT_TOKENS=8192
CHAT_RECOVERY_INPUT_TOKENS=12288
CHAT_HISTORY_TOKEN_BUDGET=1800
CHAT_SUMMARY_ENABLED=true

# You.com free MCP search: no account, API key or payment headers.
WEB_SEARCH_ENABLED=false
WEB_SEARCH_TIMEZONE=UTC
WEB_SEARCH_DAILY_LIMIT=90
YOU_WEB_SEARCH_API_KEY=
WEB_RESEARCH_DAILY_LIMIT=20
WEB_RESEARCH_USER_DAILY_LIMIT=5
WEB_SEARCH_USER_DAILY_LIMIT=10
WEB_SEARCH_USER_MINUTE_LIMIT=3
# Exact query + website + owner + current reference date. 128 shared entries maximum.
WEB_SEARCH_CACHE_SECONDS=120

# Automatic active/candidate limits; manual memories share a 1000-record account cap.
MEMORY_ACTIVE_LIMIT=200
MEMORY_PENDING_LIMIT=50
MEMORY_GOAL_DAYS=30
MEMORY_FACT_DAYS=180
MEMORY_PREFERENCE_DAYS=365

# Downloaded into the backend image at build time; inference runs locally on CPU.
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DEVICE=cpu

# Remote Qdrant Cloud collection. Its vector size is derived from the local model.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=
QDRANT_DISTANCE=Cosine

# Private source storage must be shared by the API and the durable RAG worker.
RAG_MAX_UPLOAD_BYTES=26214400
RAG_STORAGE_QUOTA_BYTES=536870912
RAG_HYBRID_ENABLED=true
RAG_MAX_PAGES=200
RAG_MAX_CHUNKS=5000
RAG_PARSER_TIMEOUT=120
RAG_JOB_LEASE_SECONDS=300
RAG_INFERENCE_THREADS=2
# Optional local-only cross-encoder directory with model-metadata.json.
RAG_RERANKER_PATH=
RAG_RERANKER_TIMEOUT=5
RAG_RERANKER_MODEL=

# Must be reachable from the browser; don't use a Docker-only service hostname.
VITE_API_URL=http://localhost:8000

# Backend workflow logging (console or json); no request/message bodies are logged.
LOG_LEVEL=INFO
LOG_FORMAT=console
LOG_FILE_ENABLED=true
# Local default; Docker mounts ./logs/backend at /var/log/mentra.
LOG_DIRECTORY=logs/backend
LOG_WORKFLOW_SUMMARIES=true
LOG_SUMMARY_MAX_STEPS=500
LOG_EVENT_MAX_BYTES=32768
LOG_HEALTH_REQUESTS=false
LOG_POLL_REQUESTS=false
# CPU-only multilingual voice input. Model name/path must match the provisioned files.
SPEECH_MODEL=base
SPEECH_CPU_THREADS=2
SPEECH_BEAM_SIZE=3
SPEECH_TIMEOUT_SECONDS=20
SPEECH_WARM_ON_STARTUP=true

# Server-only credentials; preserve FILES_NAMESPACE and the storage suffix below.
CLOUDINARY_URL=
FILES_NAMESPACE=mentra
# Empty uses APP_ENV. Preserve the original value when promoting existing data.
FILES_ENVIRONMENT=
FILES_CONCURRENCY=8
FILES_TIMEOUT_SECONDS=60
