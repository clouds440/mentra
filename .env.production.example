# Copy to private .env.production; empty values deliberately prevent deployment.
APP_ENV=production
FRONTEND_ORIGIN=
CORS_ORIGINS=
VITE_API_URL=
BACKEND_IMAGE=
FRONTEND_IMAGE=
BACKEND_BIND_ADDRESS=127.0.0.1
FRONTEND_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=8000
# Docker-published ports may present a bridge/gateway source IP to Uvicorn.
# Supply the observed proxy source IP/CIDR, not merely the host listener IP.
FORWARDED_ALLOW_IPS=
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE=lax
DATABASE_URL=
CLOUDINARY_URL=
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=
AI_PROVIDER=openai_compatible
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
LOG_FORMAT=json
LOG_PARAMETER_DETAILS=false
# Empty gives mentra/production for a fresh installation. For existing originals,
# supply the historical APP_ENV suffix instead; never rename it during rollout.
FILES_NAMESPACE=mentra
FILES_ENVIRONMENT=
